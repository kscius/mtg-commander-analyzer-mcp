{
  "name": "mtg-commander-analyzer-mcp",
  "version": "0.7.0",
  "description": "Open-source TypeScript library and MCP server for analyzing Magic: The Gathering Commander (EDH) decks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kscius/mtg-commander-analyzer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kscius/mtg-commander-analyzer-mcp/issues"
  },
  "homepage": "https://github.com/kscius/mtg-commander-analyzer-mcp#readme",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:mcp-smoke": "tsx scripts/mcpSmokeTest.ts",
    "record:golden": "tsx scripts/recordGoldenAnalyze.ts",
    "benchmark:decks": "tsx scripts/benchmarkDecks.ts",
    "decks:download-moxfield": "tsx scripts/downloadMoxfieldDecks.ts",
    "decks:user-style-profile": "tsx scripts/printUserDeckStyleProfile.ts",
    "brackets:check-official": "tsx scripts/checkBracketOfficialSources.ts",
    "brackets:check-official:quick": "tsx scripts/checkBracketOfficialSources.ts -- --skip-moxfield",
    "dev": "tsx src/mcp/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test:local": "tsx src/testLocal.ts",
    "test:build": "tsx src/testBuildLocal.ts",
    "test:e2e": "tsx src/testEndToEnd.ts",
    "clean": "rimraf dist",
    "setup": "node -e \"console.log('Please run ./setup.sh (Linux/macOS) or .\\\\setup.ps1 (Windows) to complete setup')\"",
    "db:create": "tsx src/scripts/createDatabase.ts",
    "db:create:keep": "tsx src/scripts/createDatabase.ts -- --keep",
    "db:import": "tsx src/scripts/importCards.ts",
    "db:import-rulings": "tsx src/scripts/importRulings.ts",
    "db:tag": "tsx src/scripts/tagCards.ts",
    "db:tag-stats": "tsx src/scripts/dbTagStats.ts",
    "db:stats": "tsx -e \"const db = require('./src/core/cardDatabase'); console.log(db.getDatabaseStats());\"",
    "postinstall": "npm rebuild better-sqlite3"
  },
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "commander",
    "edh",
    "deck-analyzer",
    "deck-builder",
    "mcp",
    "model-context-protocol",
    "scryfall",
    "edhrec",
    "bracket",
    "typescript",
    "ai-tools"
  ],
  "author": "MTG Commander Analyzer MCP Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/stream-json": "^1.7.8",
    "playwright": "^1.62.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.2.3",
    "openai": "^7.2.0",
    "stream-json": "1.8.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "fast-uri": ">=4.1.2",
    "hono": ">=4.12.34",
    "stream-json": "1.8.0"
  }
}
